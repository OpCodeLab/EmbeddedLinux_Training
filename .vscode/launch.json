{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lab_multithreading_debug (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/seance6/out/lab_multithreading_debug",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/seance6",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Show all thread events (create/exit)",
                    "text": "set print thread-events on",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build lab_multithreading_debug"
        }
    ]
}
